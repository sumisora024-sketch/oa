APP_NAME=NIT OA system
ENVIRONMENT=development
SECRET_KEY=change-this-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:8080
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

DATABASE_URL=mysql+pymysql://admin:admin123@127.0.0.1:3306/oa
REDIS_URL=redis://127.0.0.1:6379/0

APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=admin123
DEFAULT_EMPLOYEE_PASSWORD=ChangeMe123!
PASSWORD_RESET_EMAIL_ENABLED=false

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

DIFY_ASSISTANT_ENABLED=false
# Accepts either Dify API base (http://dify.example.com/v1), chat endpoint, or console develop URL.
DIFY_ASSISTANT_API_BASE=http://localhost/app/d705ed57-3579-4b37-b9c0-c047c85d647e/develop
DIFY_ASSISTANT_API_KEY=
DIFY_ASSISTANT_APP_URL=http://localhost/app/d705ed57-3579-4b37-b9c0-c047c85d647e/develop
DIFY_ASSISTANT_TITLE=NIT AI Help Desk
DIFY_ASSISTANT_GREETING=会社情報や社内手続きについて質問できます。
DIFY_ASSISTANT_DEFAULT_INPUTS={}
DIFY_ASSISTANT_RESPONSE_MODE=blocking
DIFY_ASSISTANT_TIMEOUT_SECONDS=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
HR_REMINDER_EMAIL=hr@nit-g.co.jp

MAILBOX_POLL_ENABLED=false
MAILBOX_POLL_INTERVAL_SECONDS=60
MAILBOX_IMAP_HOST=imap.gmail.com
MAILBOX_IMAP_USERNAME=
MAILBOX_IMAP_PASSWORD=
MAILBOX_IMAP_FOLDER=INBOX
