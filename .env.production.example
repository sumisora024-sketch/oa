# Docker image / compose
APP_VERSION=0.8
BACKEND_IMAGE=japan-nit-oa-backend
FRONTEND_IMAGE=japan-nit-oa-frontend
BACKEND_IMAGE_TAG=0.8
FRONTEND_IMAGE_TAG=0.8
HTTP_PORT=80
NIT_OA_ROOT=/opt/nit-ao
NIT_OA_CONFIG_DIR=/opt/nit-ao/config

# MySQL container
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=oa
MYSQL_USER=oa_app
MYSQL_PASSWORD=change-this-db-password

# Application
APP_NAME=NIT OA system
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
FRONTEND_URL=https://oa.example.com
BACKEND_CORS_ORIGINS=https://oa.example.com

# Initial admin and employee defaults
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_EMPLOYEE_PASSWORD=ChangeMe123!
PASSWORD_RESET_EMAIL_ENABLED=false

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

# Dify AI assistant
# DIFY_ASSISTANT_API_BASE may be a Dify API base such as https://dify.example.com/v1,
# a full /v1/chat-messages endpoint, or a console develop URL.
DIFY_ASSISTANT_ENABLED=false
DIFY_ASSISTANT_API_BASE=
DIFY_ASSISTANT_API_KEY=
DIFY_ASSISTANT_APP_URL=
DIFY_ASSISTANT_TITLE=NIT AI Help Desk
DIFY_ASSISTANT_GREETING=会社情報や社内手続きについて質問できます。
DIFY_ASSISTANT_DEFAULT_INPUTS={}
DIFY_ASSISTANT_RESPONSE_MODE=blocking
DIFY_ASSISTANT_TIMEOUT_SECONDS=60

# File storage
# Current v0.8 image stores uploads/generated files under /opt/nit-ao/storage.
# S3 values are reserved for the next storage backend switch and are not used by this image yet.
STORAGE_BACKEND=local
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=nit-oa
S3_ENDPOINT_URL=

# SMTP / mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
HR_REMINDER_EMAIL=hr@nit-g.co.jp

MAILBOX_POLL_ENABLED=false
MAILBOX_POLL_INTERVAL_SECONDS=60
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_USERNAME=
MAILBOX_IMAP_PASSWORD=
MAILBOX_IMAP_FOLDER=INBOX
